# ============================================
# NEXUS IA - Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# --- AI Provider ---
MOONSHOT_API_KEY=sk-your-moonshot-key
OPENROUTER_API_KEY=sk-your-openrouter-key
GROQ_API_KEY=gsk-your-groq-key
TOGETHER_API_KEY=your-together-key

# --- Payments (Flutterwave) ---
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=NEXUS IA <noreply@nexusia.ao>

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=Ov23lixxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:3002/v1/auth/github/callback

# --- Redis (optional for local dev) ---
REDIS_URL=redis://localhost:6379

# --- Database (Railway / Docker only) ---
# DB_PATH=/app/data/nexus.db
# USE_BETTER_SQLITE=1

# --- Security ---
JWT_SECRET=change-this-to-a-random-string
ENCRYPTION_KEY=another-random-string

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3002
